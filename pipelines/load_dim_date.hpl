<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>load_dim_date</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load distinct UTC calendar dates from RetailRocket events into public.dim_date.</description>
    <extended_description>Reads event epoch timestamps, derives the date hierarchy in UTC, keeps one row per date_key, then inserts or updates dim_date.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/25 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>CSV Event Timestamps</from>
      <to>Derive UTC Date Attributes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Derive UTC Date Attributes</from>
      <to>Sort by Date Key</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort by Date Key</from>
      <to>Keep One Row per Date</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep One Row per Date</from>
      <to>Insert / Update Date Dimension</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>CSV Event Timestamps</name>
    <type>CSVInput</type>
    <description>Read only the epoch-millisecond timestamp column from events.csv.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/data/events.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition/>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>timestamp</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Derive UTC Date Attributes</name>
    <type>ScriptValueMod</type>
    <description>Convert epoch milliseconds to one UTC calendar date and its reporting attributes.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Derive UTC date dimension fields</jsScript_name>
        <jsScript_script>var localDate = java.time.Instant.ofEpochMilli(timestamp).atZone(java.time.ZoneOffset.UTC).toLocalDate();
var day_number = localDate.getDayOfMonth();
var month_number = localDate.getMonthValue();
var year_number = localDate.getYear();
var full_date = new Date(Date.UTC(year_number, month_number - 1, day_number));
var date_key = year_number * 10000 + month_number * 100 + day_number;
var month_name = localDate.getMonth().getDisplayName(java.time.format.TextStyle.FULL, java.util.Locale.ENGLISH);
var quarter_number = Math.floor((month_number - 1) / 3) + 1;
var day_of_week = localDate.getDayOfWeek().getValue();</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>date_key</name>
        <rename>date_key</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>full_date</name>
        <rename>full_date</rename>
        <type>Date</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>day_number</name>
        <rename>day_number</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>month_number</name>
        <rename>month_number</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>month_name</name>
        <rename>month_name</rename>
        <type>String</type>
        <length>15</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>quarter_number</name>
        <rename>quarter_number</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>year_number</name>
        <rename>year_number</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>day_of_week</name>
        <rename>day_of_week</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Sort by Date Key</name>
    <type>SortRows</type>
    <description>Sort derived rows before streaming deduplication.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>retailrocket_dates</prefix>
    <sort_size>5000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>date_key</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Keep One Row per Date</name>
    <type>Unique</type>
    <description>Keep the first row for every sorted date_key.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <count_rows>N</count_rows>
    <count_field/>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <fields>
      <field>
        <name>date_key</name>
        <case_insensitive>N</case_insensitive>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Insert / Update Date Dimension</name>
    <type>InsertUpdate</type>
    <description>Insert dates that are not present and refresh their derived attributes when they are present.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>retailrocket_dw_conn</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>public</schema>
      <table>dim_date</table>
      <key>
        <name>date_key</name>
        <field>date_key</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>date_key</name>
        <rename>date_key</rename>
        <update>N</update>
      </value>
      <value>
        <name>full_date</name>
        <rename>full_date</rename>
        <update>Y</update>
      </value>
      <value>
        <name>day_number</name>
        <rename>day_number</rename>
        <update>Y</update>
      </value>
      <value>
        <name>month_number</name>
        <rename>month_number</rename>
        <update>Y</update>
      </value>
      <value>
        <name>month_name</name>
        <rename>month_name</rename>
        <update>Y</update>
      </value>
      <value>
        <name>quarter_number</name>
        <rename>quarter_number</rename>
        <update>Y</update>
      </value>
      <value>
        <name>year_number</name>
        <rename>year_number</rename>
        <update>Y</update>
      </value>
      <value>
        <name>day_of_week</name>
        <rename>day_of_week</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
