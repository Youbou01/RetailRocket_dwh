<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>load_dim_item</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load every event item into public.dim_item with its latest known category.</description>
    <extended_description>Creates the complete item set from events.csv, left-joins the staged latest category mapping, then upserts dim_item by item_id. Items without a category remain valid dimension rows with a NULL category_id.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/25 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>Read Event Items</from><to>Keep Event Item IDs</to><enabled>Y</enabled></hop>
    <hop><from>Keep Event Item IDs</from><to>Sort Event Item IDs</to><enabled>Y</enabled></hop>
    <hop><from>Sort Event Item IDs</from><to>Keep Distinct Event Items</to><enabled>Y</enabled></hop>
    <hop><from>Read Staged Categories</from><to>Sort Staged Categories</to><enabled>Y</enabled></hop>
    <hop><from>Keep Distinct Event Items</from><to>Match Items to Categories</to><enabled>Y</enabled></hop>
    <hop><from>Sort Staged Categories</from><to>Match Items to Categories</to><enabled>Y</enabled></hop>
    <hop><from>Match Items to Categories</from><to>Validate Categories in Warehouse</to><enabled>Y</enabled></hop>
    <hop><from>Validate Categories in Warehouse</from><to>Select Item Dimension Fields</to><enabled>Y</enabled></hop>
    <hop><from>Select Item Dimension Fields</from><to>Insert / Update Item Dimension</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read Event Items</name>
    <type>CSVInput</type>
    <description>Read timestamp and item ID columns so every item occurring in events is represented.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${PROJECT_HOME}/data/events.csv</filename>
    <filename_field/><rownum_field/><include_filename>N</include_filename>
    <separator>,</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><schemaDefinition/>
    <lazy_conversion>N</lazy_conversion><add_filename_result>N</add_filename_result><parallel>N</parallel><newline_possible>N</newline_possible><encoding>UTF-8</encoding>
    <fields>
      <field><name>timestamp</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>itemid</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>80</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>Keep Event Item IDs</name>
    <type>SelectValues</type>
    <description>Remove the unused timestamp and rename itemid for the warehouse stream.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><name>itemid</name><rename>item_id</rename><length>-2</length><precision>-2</precision></field><select_unspecified>N</select_unspecified></fields>
    <attributes/>
    <GUI><xloc>288</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>Sort Event Item IDs</name>
    <type>SortRows</type>
    <description>Sort event items before deduplication and merge joining.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <directory>${java.io.tmpdir}</directory><prefix>retailrocket_event_items</prefix><sort_size>5000</sort_size><free_memory/><compress>N</compress><compress_variable/><unique_rows>N</unique_rows>
    <fields><field><name>item_id</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field></fields>
    <attributes/>
    <GUI><xloc>496</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>Keep Distinct Event Items</name>
    <type>Unique</type>
    <description>Keep one row per item observed in the event source.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <count_rows>N</count_rows><count_field/><reject_duplicate_row>N</reject_duplicate_row><error_description/>
    <fields><field><name>item_id</name><case_insensitive>N</case_insensitive></field></fields>
    <attributes/>
    <GUI><xloc>704</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>Read Staged Categories</name>
    <type>CSVInput</type>
    <description>Read the latest item-category assignment prepared by stage_item_latest_category.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${PROJECT_HOME}/data/staging/item_latest_category.csv</filename>
    <filename_field/><rownum_field/><include_filename>N</include_filename>
    <separator>,</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><schemaDefinition/>
    <lazy_conversion>N</lazy_conversion><add_filename_result>N</add_filename_result><parallel>N</parallel><newline_possible>N</newline_possible><encoding>UTF-8</encoding>
    <fields>
      <field><name>category_item_id</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>category_id</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>category_timestamp</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>496</xloc><yloc>288</yloc></GUI>
  </transform>
  <transform>
    <name>Sort Staged Categories</name>
    <type>SortRows</type>
    <description>Sort category mappings to satisfy the merge join requirement.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <directory>${java.io.tmpdir}</directory><prefix>retailrocket_staged_categories</prefix><sort_size>5000</sort_size><free_memory/><compress>N</compress><compress_variable/><unique_rows>N</unique_rows>
    <fields><field><name>category_item_id</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field></fields>
    <attributes/>
    <GUI><xloc>704</xloc><yloc>288</yloc></GUI>
  </transform>
  <transform>
    <name>Match Items to Categories</name>
    <type>MergeJoin</type>
    <description>Left join every event item to its latest staged category assignment.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <join_type>LEFT OUTER</join_type>
    <keys_1><key>item_id</key></keys_1>
    <keys_2><key>category_item_id</key></keys_2>
    <transform1>Keep Distinct Event Items</transform1>
    <transform2>Sort Staged Categories</transform2>
    <attributes/>
    <GUI><xloc>912</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform>
    <name>Validate Categories in Warehouse</name>
    <type>DBLookup</type>
    <description>Keep a category ID only when it exists in dim_category; unmatched categories become NULL.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <cache_size>2000</cache_size><cache>Y</cache><connection>retailrocket_dw_conn</connection><cache_load_all>Y</cache_load_all>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure><fail_on_multiple>Y</fail_on_multiple>
      <schema>public</schema><table>dim_category</table>
      <key><condition>=</condition><name>category_id</name><field>category_id</field></key>
      <value><type>Integer</type><rename>validated_category_id</rename><name>category_id</name><trim_type>both</trim_type></value>
    </lookup>
    <attributes/>
    <GUI><xloc>1016</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform>
    <name>Select Item Dimension Fields</name>
    <type>SelectValues</type>
    <description>Keep the natural item ID and validated optional category ID for dim_item.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>item_id</name><rename>item_id</rename><length>-2</length><precision>-2</precision></field>
      <field><name>validated_category_id</name><rename>category_id</rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI><xloc>1208</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform>
    <name>Insert / Update Item Dimension</name>
    <type>InsertUpdate</type>
    <description>Insert event items not yet in the dimension and refresh their category assignment.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>retailrocket_dw_conn</connection><commit>1000</commit><update_bypassed>N</update_bypassed>
    <lookup>
      <schema>public</schema><table>dim_item</table>
      <key><name>item_id</name><field>item_id</field><condition>=</condition><name2/></key>
      <value><name>item_id</name><rename>item_id</rename><update>N</update></value>
      <value><name>category_id</name><rename>category_id</rename><update>Y</update></value>
    </lookup>
    <attributes/>
    <GUI><xloc>1400</xloc><yloc>192</yloc></GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
