<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>load_fact_events</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load one fact row for every RetailRocket event.</description>
    <extended_description>Reads events.csv, converts epoch milliseconds to a UTC event timestamp and date key, resolves date, visitor, item and event-type keys, and inserts the resulting rows into public.fact_events. Run only after all dimensions are complete, and only once against an empty fact table: the table has no stable source-event key for safe fact-row deduplication.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/25 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop><from>CSV Event Rows</from><to>Derive Event Date and Measures</to><enabled>Y</enabled></hop>
    <hop><from>Derive Event Date and Measures</from><to>Rename Source Fields</to><enabled>Y</enabled></hop>
    <hop><from>Rename Source Fields</from><to>Lookup Date Key</to><enabled>Y</enabled></hop>
    <hop><from>Lookup Date Key</from><to>Lookup Visitor Key</to><enabled>Y</enabled></hop>
    <hop><from>Lookup Visitor Key</from><to>Lookup Item Key</to><enabled>Y</enabled></hop>
    <hop><from>Lookup Item Key</from><to>Lookup Event Type Key</to><enabled>Y</enabled></hop>
    <hop><from>Lookup Event Type Key</from><to>Select Fact Fields</to><enabled>Y</enabled></hop>
    <hop><from>Select Fact Fields</from><to>Insert Fact Events</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>CSV Event Rows</name>
    <type>CSVInput</type>
    <description>Read the event grain and nullable transaction ID from events.csv.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${PROJECT_HOME}/data/events.csv</filename>
    <filename_field/><rownum_field/><include_filename>N</include_filename>
    <separator>,</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><schemaDefinition/>
    <lazy_conversion>N</lazy_conversion><add_filename_result>N</add_filename_result><parallel>N</parallel><newline_possible>N</newline_possible><encoding>UTF-8</encoding>
    <fields>
      <field><name>timestamp</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>visitorid</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>event</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>itemid</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>transactionid</name><type>Integer</type><format/><currency/><decimal>.</decimal><group>,</group><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>96</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Derive Event Date and Measures</name>
    <type>ScriptValueMod</type>
    <description>Derive the exact event timestamp, UTC date key and additive event count.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Derive fact date fields</jsScript_name>
        <jsScript_script>var localDate = java.time.Instant.ofEpochMilli(timestamp).atZone(java.time.ZoneOffset.UTC).toLocalDate();
var event_timestamp = new Date(timestamp);
var date_key = localDate.getYear() * 10000 + localDate.getMonthValue() * 100 + localDate.getDayOfMonth();
var event_count = 1;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>event_timestamp</name><rename>event_timestamp</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>date_key</name><rename>date_key</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>event_count</name><rename>event_count</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <GUI><xloc>288</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Rename Source Fields</name>
    <type>SelectValues</type>
    <description>Rename source identifiers to the warehouse natural-key names.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>date_key</name><rename>date_key</rename><length>-2</length><precision>-2</precision></field>
      <field><name>event_timestamp</name><rename>event_timestamp</rename><length>-2</length><precision>-2</precision></field>
      <field><name>event_count</name><rename>event_count</rename><length>-2</length><precision>-2</precision></field>
      <field><name>visitorid</name><rename>visitor_id</rename><length>-2</length><precision>-2</precision></field>
      <field><name>event</name><rename>event_type</rename><length>-2</length><precision>-2</precision></field>
      <field><name>itemid</name><rename>item_id</rename><length>-2</length><precision>-2</precision></field>
      <field><name>transactionid</name><rename>transaction_id</rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Lookup Date Key</name>
    <type>DBLookup</type>
    <description>Validate the derived date key against dim_date.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <cache_size>100</cache_size><cache>Y</cache><connection>retailrocket_dw_conn</connection><cache_load_all>Y</cache_load_all>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure><fail_on_multiple>Y</fail_on_multiple>
      <schema>public</schema><table>dim_date</table>
      <key><condition>=</condition><name>date_key</name><field>date_key</field></key>
      <value><type>Integer</type><rename>date_key_lookup</rename><name>date_key</name><trim_type>both</trim_type></value>
    </lookup>
    <attributes/>
    <GUI><xloc>672</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Lookup Visitor Key</name>
    <type>DBLookup</type>
    <description>Resolve visitor_id to its generated visitor_key.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <cache_size>1500000</cache_size><cache>Y</cache><connection>retailrocket_dw_conn</connection><cache_load_all>Y</cache_load_all>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure><fail_on_multiple>Y</fail_on_multiple>
      <schema>public</schema><table>dim_visitor</table>
      <key><condition>=</condition><name>visitor_id</name><field>visitor_id</field></key>
      <value><type>Integer</type><rename>visitor_key</rename><name>visitor_key</name><trim_type>both</trim_type></value>
    </lookup>
    <attributes/>
    <GUI><xloc>864</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Lookup Item Key</name>
    <type>DBLookup</type>
    <description>Resolve item_id to its generated item_key.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <cache_size>300000</cache_size><cache>Y</cache><connection>retailrocket_dw_conn</connection><cache_load_all>Y</cache_load_all>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure><fail_on_multiple>Y</fail_on_multiple>
      <schema>public</schema><table>dim_item</table>
      <key><condition>=</condition><name>item_id</name><field>item_id</field></key>
      <value><type>Integer</type><rename>item_key</rename><name>item_key</name><trim_type>both</trim_type></value>
    </lookup>
    <attributes/>
    <GUI><xloc>1056</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Lookup Event Type Key</name>
    <type>DBLookup</type>
    <description>Resolve event_type to its generated event_type_key.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <cache_size>10</cache_size><cache>Y</cache><connection>retailrocket_dw_conn</connection><cache_load_all>Y</cache_load_all>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure><fail_on_multiple>Y</fail_on_multiple>
      <schema>public</schema><table>dim_event_type</table>
      <key><condition>=</condition><name>event_type</name><field>event_type</field></key>
      <value><type>Integer</type><rename>event_type_key</rename><name>event_type_key</name><trim_type>both</trim_type></value>
    </lookup>
    <attributes/>
    <GUI><xloc>1248</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Select Fact Fields</name>
    <type>SelectValues</type>
    <description>Keep only fact foreign keys, timestamp, nullable transaction ID and event measure.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>date_key_lookup</name><rename>date_key</rename><length>-2</length><precision>-2</precision></field>
      <field><name>visitor_key</name><rename>visitor_key</rename><length>-2</length><precision>-2</precision></field>
      <field><name>item_key</name><rename>item_key</rename><length>-2</length><precision>-2</precision></field>
      <field><name>event_type_key</name><rename>event_type_key</rename><length>-2</length><precision>-2</precision></field>
      <field><name>event_timestamp</name><rename>event_timestamp</rename><length>-2</length><precision>-2</precision></field>
      <field><name>transaction_id</name><rename>transaction_id</rename><length>-2</length><precision>-2</precision></field>
      <field><name>event_count</name><rename>event_count</rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI><xloc>1440</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Insert Fact Events</name>
    <type>TableOutput</type>
    <description>Append one row per source event; do not truncate the fact table.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit>
    <connection>retailrocket_dw_conn</connection>
    <schema>public</schema>
    <fields/>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>fact_events</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI><xloc>1632</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
