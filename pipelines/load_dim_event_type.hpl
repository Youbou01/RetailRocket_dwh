<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>load_dim_event_type</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load distinct RetailRocket event types into public.dim_event_type.</description>
    <extended_description>Reads event names from events.csv, trims whitespace, keeps the expected event types (view, addtocart, transaction), deduplicates them, and inserts missing event types by their natural key.</extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/11/25 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/11/25 00:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>CSV Event Values</from>
      <to>Trim Event Values</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Trim Event Values</from>
      <to>Rename Event Field</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Rename Event Field</from>
      <to>Keep Expected Event Types</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep Expected Event Types</from>
      <to>Sort Event Types</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Sort Event Types</from>
      <to>Keep One Row per Event Type</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep One Row per Event Type</from>
      <to>Insert Missing Event Types</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>CSV Event Values</name>
    <type>CSVInput</type>
    <description>Read the event column from events.csv.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/data/events.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition/>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>event</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Trim Event Values</name>
    <type>StringOperations</type>
    <description>Remove leading and trailing whitespace from each source event value.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>event</in_stream_name>
        <out_stream_name>event_trimmed</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Rename Event Field</name>
    <type>SelectValues</type>
    <description>Rename the cleaned source field to the warehouse natural key.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>event_trimmed</name>
        <rename>event_type</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Keep Expected Event Types</name>
    <type>FilterRows</type>
    <description>Accept only the three event values defined by the source dataset.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Sort Event Types</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>event_type</leftvalue>
        <function>IN LIST</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>view;addtocart;transaction</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Sort Event Types</name>
    <type>SortRows</type>
    <description>Sort event values before streaming deduplication.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <directory>${java.io.tmpdir}</directory>
    <prefix>retailrocket_event_types</prefix>
    <sort_size>5000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field>
        <name>event_type</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Keep One Row per Event Type</name>
    <type>Unique</type>
    <description>Keep one row per distinct cleaned event type.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <count_rows>N</count_rows>
    <count_field/>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <fields>
      <field>
        <name>event_type</name>
        <case_insensitive>N</case_insensitive>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Insert Missing Event Types</name>
    <type>InsertUpdate</type>
    <description>Insert an event type when it is not already present, matching on event_type.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>retailrocket_dw_conn</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>event_type</field>
        <name>event_type</name>
        <name2/>
      </key>
      <schema>public</schema>
      <table>dim_event_type</table>
      <value>
        <name>event_type</name>
        <rename>event_type</rename>
        <update>N</update>
      </value>
    </lookup>
    <update_bypassed>N</update_bypassed>
    <attributes/>
    <GUI>
      <xloc>1248</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
